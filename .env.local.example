# Copy this file to .env.local and fill in your real credentials
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="Demo Café <your-email@example.com>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true

# Twilio configuration for SMS and WhatsApp notifications
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-sms-number
TWILIO_WHATSAPP_FROM=whatsapp:+your-twilio-whatsapp-number
